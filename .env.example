# Formspree form ID only (e.g. xyzabcde) — NEVER put an email address here.
# Prefer the server-side var; NEXT_PUBLIC_ works too if you need client-side POST.
FORMSPREE_ID=
NEXT_PUBLIC_FORMSPREE_ID=

# Canonical site URL for Open Graph / Stripe redirects / metadataBase
NEXT_PUBLIC_SITE_URL=https://ilemi.ia

# Auth (never commit real secrets — set them in Vercel / .env.local)
ADMIN_EMAIL=makboulathraoufou@gmail.com
ADMIN_PASSWORD=
AUTH_SECRET=

# SQLite local. On Vercel (VERCEL=1) the app uses file:/tmp/ilemi.db at runtime
# (ephemeral). For production persistence, switch later to Postgres.
DATABASE_URL="file:./prisma/dev.db"

# --- Studio generation (server-only; pick at least one for images) ---
FAL_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# --- Rewarded ads (Google AdSense) ---
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_REWARD=
# Dev only: allow simulating +1 credit without AdSense
ALLOW_FAKE_ADS=false

# --- Stripe subscription (monthly Pro) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google AI Studio (Gemini image generation — free tier)
GEMINI_API_KEY=

# Chat Assistant (Groq Llama 3.3)
GROQ_API_KEY=

# --- Mobile Money (crédits Studio) ---
# Merchant / receiving number shown in USSD & transfer UI
MM_MERCHANT_NUMBER=0153651682

# --- Admin email alerts (Mobile Money credit orders) ---
# Resend API key — required to actually send. Without it, notifies are logged/no-op.
# Create at https://resend.com → API Keys. Set in Vercel env.
RESEND_API_KEY=
# Recipient (default: makboulathraoufou@gmail.com). Falls back to ADMIN_EMAIL.
CREDITS_NOTIFY_EMAIL=makboulathraoufou@gmail.com
# Optional From (must be a verified Resend domain/sender). Default: onboarding@resend.dev
# RESEND_FROM_EMAIL=ilémi.IA <noreply@yourdomain.com>
