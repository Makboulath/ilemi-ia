generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum CreditOrderStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  role                 Role      @default(MEMBER)
  displayName          String?
  plan                 String    @default("FREE")
  /// HQ image credits (existing wallet field — packs grant here)
  credits              Int       @default(7)
  creditsBootstrapped  Boolean   @default(true)
  /// Purchased video entitlements (packs grant here)
  videoCredits         Int       @default(0)
  videoDate            String?
  videoCountToday      Int       @default(0)
  stripeCustomerId     String?
  /// SHA-256 of password-reset token (raw token only sent by email)
  passwordResetHash    String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())

  courseProgress CourseProgress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
  generations    StudioGeneration[]
  creditOrders   CreditOrder[]
}

model CreditOrder {
  id             String            @id @default(cuid())
  code           String            @unique
  userId         String
  packId         String
  amountFcfa     Int
  imageCredits   Int
  videoCredits   Int
  status         CreditOrderStatus @default(PENDING)
  smsRef         String?
  merchantNumber String
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model Conversion {
  id        String   @id @default(cuid())
  type      String
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

model CourseProgress {
  id                 String   @id @default(cuid())
  userId             String
  pathId             String
  completedLessonIds String   @default("[]")
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
  @@index([userId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  pathId    String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pathId])
  @@index([createdAt])
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  pathId      String
  code        String   @unique
  issuedAt    DateTime @default(now())
  learnerName String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
  @@index([userId])
}

model StudioGeneration {
  id        String   @id @default(cuid())
  userId    String
  type      String
  prompt    String
  url       String?
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
